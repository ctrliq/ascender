{
  "compilerOptions": {
    // Vite strips the types, so this compiler never emits: it only checks.
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // describe, it, expect and vi come from the runner's globals rather than
    // from imports, which is how the 553 test files are written.
    "types": ["vitest/globals", "vite/client"],

    // The whole approach in one flag. JavaScript and TypeScript compile side
    // by side, so a file becomes typed when someone touches it rather than in
    // a conversion pass. checkJs stays off: turning it on would report on
    // 1,627 untyped files at once, which is the opposite of incremental.
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,

    // The same absolute imports the bundler resolves, from
    // config/build/aliases.mjs. Editors and tsc read these; Vite does not.
    // Written relative to this file rather than under a baseUrl, which
    // TypeScript 6 deprecates and 7 removes.
    "paths": {
      "api": ["./src/api/index.ts"],
      "api/*": ["./src/api/*"],
      "components/*": ["./src/components/*"],
      "contexts/*": ["./src/contexts/*"],
      "hooks/*": ["./src/hooks/*"],
      "screens/*": ["./src/screens/*"],
      "types/api": ["./src/types/api.ts"],
      "types/*": ["./src/types/*"],
      "util/*": ["./src/util/*"],
      "i18nLoader": ["./src/i18nLoader.ts"],
      "themeRegistry": ["./src/themeRegistry.ts"],
      // The tests reach for history v5 by name; the runner points that at a
      // shim over react-router's own, and this points the checker at the same.
      "history": ["./testUtils/historyShim.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "testUtils/**/*.ts", "testUtils/**/*.tsx"],
  "exclude": ["node_modules", "build", "e2e"]
}
