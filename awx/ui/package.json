  "scripts": {
    "prelint": "lingui compile",
    "prestart": "lingui compile",
    "pretest": "lingui compile",
    "pretest-watch": "lingui compile",
    "start": "vite",
    "build": "vite build",
    "test": "TZ='UTC' vitest run",
    "test-screens": "TZ='UTC' vitest run src/screens",
    "test-general": "TZ='UTC' vitest run --exclude 'src/screens/**'",
    "test-watch": "TZ='UTC' vitest",
    "lint": "NODE_ENV=development eslint .",
    "type-check": "tsc --noEmit",
    "generate-api-types": "npx --yes openapi-typescript@7 .schema.json -o src/types/api.generated.ts",
    "extract-strings": "lingui extract",
    "extract-template": "lingui extract-template",
    "compile-strings": "lingui compile",
    "prettier": "prettier --cache --write \"src/**/*.{js,jsx,scss}\"",
    "prettier-check": "prettier --cache --check \"src/**/*.{js,jsx,scss}\""
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 114",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ]
