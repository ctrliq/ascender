msgstr "منفذ خادم RADIUS."

#: awx/sso/conf.py:487
msgid "RADIUS Secret"
msgstr "سر RADIUS"

#: awx/sso/conf.py:488
msgid "Shared secret for authenticating to RADIUS server."
msgstr "السر المشترك للمصادقة مع خادم RADIUS."

#: awx/sso/conf.py:503
msgid "TACACS+ Server"
msgstr "خادم TACACS+"

#: awx/sso/conf.py:504
