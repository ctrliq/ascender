#: awx/main/conf.py:389
msgid "Expose host paths for Container Groups"
msgstr "كشف مسارات المضيف لمجموعات الحاويات"

#: awx/main/conf.py:391
msgid ""
"Expose paths via hostPath for the Pods created by a Container Group. "
"HostPath volumes present many security risks, and it is a best practice to "
"avoid the use of HostPaths when possible. "
msgstr ""
"كشف المسارات عبر hostPath للـ Pods التي أنشأتها مجموعة حاويات. تشكل وحدات "
