msgstr "السر المشترك للمصادقة مع خادم TACACS+."

#: awx/sso/conf.py:539
msgid "TACACS+ Auth Session Timeout"
msgstr "مهلة جلسة مصادقة TACACS+"

#: awx/sso/conf.py:540
msgid "TACACS+ session timeout value in seconds, 0 disables timeout."
msgstr "قيمة مهلة جلسة TACACS+ بالثواني، 0 يعطل المهلة."

#: awx/sso/conf.py:551
msgid "TACACS+ Authentication Protocol"
msgstr "بروتوكول مصادقة TACACS+"

#: awx/sso/conf.py:552
msgid "Choose the authentication protocol used by TACACS+ client."
msgstr "اختر بروتوكول المصادقة المستخدم بواسطة عميل TACACS+."

#: awx/sso/conf.py:561
msgid "TACACS+ client address sending enabled"
msgstr "إرسال عنوان عميل TACACS+ مُفعّل"

#: awx/sso/conf.py:562
#, fuzzy
#| msgid "Choose the authentication protocol used by TACACS+ client."
msgid "Enable the client address sending by TACACS+ client."
msgstr "تمكين إرسال عنوان العميل بواسطة عميل TACACS+."

#: awx/sso/conf.py:576
msgid "Google OAuth2 Callback URL"
msgstr "عنوان URL لاستدعاء Google OAuth2"

