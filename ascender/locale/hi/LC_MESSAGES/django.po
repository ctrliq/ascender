#: awx/sso/apps.py:8
msgid "Single Sign-On"
msgstr "सिंगल साइन-ऑन"

#: awx/sso/conf.py:53
#, fuzzy
#| msgid ""
#| "Mapping to organization admins/users from social auth accounts. This setting\n"
#| "controls which users are placed into which organizations based on their\n"
#| "username and email address. Configuration details are available in the \n"
#| "documentation."
msgid ""
"Mapping to organization admins/users from social auth accounts. This setting\n"
"controls which users are placed into which organizations based on their\n"
"username and email address. Configuration details are available in the\n"
