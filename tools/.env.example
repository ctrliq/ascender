# Per-machine settings for the development tools (tools/Makefile). Copy to
# tools/.env (git-ignored) and uncomment what you change. A variable set on
# the command line or in the environment wins over the file.

# The development stack's network the tools join, and its task container.
#ASCENDER_NETWORK=ascender
#TASK_CONTAINER=ascender_task

# NetBox (make netbox-start): where it is published on the host.
#NETBOX_BIND=127.0.0.1
#NETBOX_PORT=8000
# The execution environment make netbox-ee builds.
#NETBOX_EE_IMAGE=localhost/ascender-ee-netbox:dev
