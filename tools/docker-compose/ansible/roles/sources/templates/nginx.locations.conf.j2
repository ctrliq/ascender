{# The ingress prefix without its trailing slash: "" for the default "/", "/awx"
   for "/awx/" or "/awx". uwsgi's mount used to strip the prefix itself before
   Django saw the path. uvicorn does the opposite: --root-path is prepended to
   whatever path it is handed, so the prefix must come off here, or Django is
   asked for /awx/awx/api/. With no prefix, nothing below changes. #}
{% set prefix = ingress_path.rstrip('/') %}
location {{ (ingress_path + '/static').replace('//', '/') }} {
    alias /var/lib/ascender/public/static/;
}

location {{ (ingress_path + '/locales').replace('//', '/') }} {
    alias /var/lib/ascender/public/static/awx/locales;
}

location {{ (ingress_path + '/favicon.ico').replace('//', '/') }} {
    alias /ascender_devel/ascender/public/static/favicon.ico;
}

{# Prefix locations rather than one regex over both paths: the mount is a path,
   not a pattern, and a "+" or "[" in it would be read as one. The URI on
   proxy_pass replaces the matched prefix, which takes the mount off the front;
   uvicorn's --root-path puts it back. With no mount, it replaces it with itself. #}
{% for path in ['/websocket/', '/api/websocket/'] %}
location {{ prefix }}{{ path }} {
    # Pass request to the upstream alias
    proxy_pass http://uvicorn{{ path }};
    # Require http version 1.1 to allow for upgrade requests
    proxy_http_version 1.1;
    # We want proxy_buffering off for proxying to websockets.
    proxy_buffering off;
    # http://en.wikipedia.org/wiki/X-Forwarded-For
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # enable this if you use HTTPS:
    proxy_set_header X-Forwarded-Proto https;
    # pass the Host: header from the client for the sake of redirects
    proxy_set_header Host $http_host;
    # We've set the Host header, so we don't need Nginx to muddle
    # about with redirects
    proxy_redirect off;
    # Depending on the request value, set the Upgrade and
    # connection headers
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
}

{% endfor %}
{% if prefix %}
location = {{ prefix }} {
    return 301 {{ prefix }}/$is_args$args;
}

{% endif %}
location {{ prefix }}/ {
    # Add trailing / if missing
    rewrite ^(.*)$http_host(.*[^/])$ $1$http_host$2/ permanent;
    proxy_read_timeout 120s;
{% if prefix %}
    # The trailing slash makes nginx replace the matched prefix with "/", so
    # /awx/api/ reaches uvicorn as /api/ and --root-path /awx puts it back.
    proxy_pass http://uvicorn/;
{% else %}
    proxy_pass http://uvicorn;
{% endif %}
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Host $http_host;
    proxy_redirect off;
    error_page 502 = @fallback;
}

# Enable scenario where we shutdown uvicorn and launching runserver for debugging purposes
location @fallback {
    # Add trailing / if missing
    rewrite ^(.*)$http_host(.*[^/])$ $1$http_host$2/ permanent;
{% if prefix %}
    # runserver has no --root-path, so it answers below the prefix but the
    # URLs it reverses will not carry it. Good enough for a debugging fallback.
    rewrite ^{{ prefix | regex_escape }}(/.*)$ $1 break;
{% endif %}
    proxy_pass http://runserver;
    proxy_set_header Host $http_host;
}
