RUN dnf -y update && dnf install -y 'dnf-command(config-manager)' && \
    dnf config-manager --set-enabled crb && \
    dnf module reset nodejs -y && \
    dnf module enable nodejs:22 -y && \
    dnf -y install \
    iputils \
    gcc \
    gcc-c++ \
    git-core \
    gettext \
    glibc-langpack-en \
    libffi-devel \
    libtool-ltdl-devel \
    make \
{% if not headless|bool %}
    nodejs \
    npm \
{% endif %}
    nss \
    openldap-devel \
    patch \
    postgresql \
    postgresql-devel \
    python3.14 \
    "python3.14-devel" \
    "python3.14-pip" \
    "python3.14-setuptools" \
    "python3.14-packaging" \
    swig \
    unzip \
    xmlsec1-devel \
    xmlsec1-openssl-devel

RUN pip3.14 install -vv build

{% if image_architecture == 'ppc64le'  %}
    RUN dnf -y update && dnf install -y wget && \
    wget https://static.rust-lang.org/dist/rust-1.41.0-powerpc64le-unknown-linux-gnu.tar.gz && \
