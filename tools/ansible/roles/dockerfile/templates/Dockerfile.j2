{% endif %}

# Install & build requirements
ADD Makefile /tmp/Makefile
RUN mkdir /tmp/requirements
ADD requirements/requirements.txt \
    requirements/requirements_tower_uninstall.txt \
    requirements/requirements_git.txt \
    /tmp/requirements/

RUN cd /tmp && make requirements_ascender

# The data the platform reads and writes lives at /var/lib/ascender, and
# /var/lib/awx is the alias onto it. Pointed this way round, retiring the old
# name is one deleted symlink rather than a move of everything on disk. A
# deployment still mounting a volume at /var/lib/awx keeps working: the runtime
# resolves the link and lands the mount on the directory it names.
RUN ln -s /var/lib/ascender /var/lib/awx

ARG VERSION
ARG SETUPTOOLS_SCM_PRETEND_VERSION
ARG HEADLESS

{% if (build_dev|bool) or (kube_dev|bool) %}
ADD requirements/requirements_dev.txt /tmp/requirements
RUN cd /tmp && make requirements_ascender_dev
{% else %}
# Use the distro provided npm to bootstrap our required version of node

#{% if not headless|bool %}
#RUN npm install -g n && n 20.19.5
#{% endif %}

# Copy source into builder, build sdist, install it into awx venv
COPY . /tmp/src/
WORKDIR /tmp/src/
RUN make sdist && /var/lib/ascender/venv/awx/bin/pip install dist/ascender.tar.gz

{% if not headless|bool %}
# collectstatic only needs settings that import cleanly and define nothing.
# An empty .py does that. /dev/null does not: django-split-settings past
# 1.0.0 builds the module from an import spec, and a path with no source
# suffix yields no spec, so include() fails before collectstatic starts.
RUN touch /tmp/empty_settings.py \
    && AWX_SETTINGS_FILE=/tmp/empty_settings.py SKIP_SECRET_KEY_CHECK=yes SKIP_PG_VERSION_CHECK=yes /var/lib/ascender/venv/awx/bin/awx-manage collectstatic --noinput --clear \
    && rm -f /tmp/empty_settings.py
{% endif %}

{% endif %}

