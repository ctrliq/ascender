{
    "name": "Install Bundle",
    "description": "",
    "renders": [
        "application/json",
        "text/html"
    ],
    "parses": [
        "application/json"
    ],
    "actions": {
        "GET": {
            "id": {
                "type": "integer",
                "label": "ID",
                "help_text": "Database ID for this instance.",
                "filterable": true
            },
            "hostname": {
                "type": "string",
                "label": "Hostname",
                "filterable": true
            },
            "type": {
                "type": "choice",
                "label": "Type",
                "help_text": "Data type for this instance.",
                "choices": [
                    ["instance", "Instance"]
                ]
            },
            "url": {
                "type": "string",
                "label": "Url",
                "help_text": "URL for this instance.",
                "filterable": false
            },
            "related": {
                "type": "object",
                "label": "Related",
                "help_text": "Data structure with URLs of related resources.",
                "filterable": false
            },
            "summary_fields": {
                "type": "object",
                "label": "Summary fields",
                "help_text": "Data structure with name/description for related resources.  The output for some objects may be limited for performance reasons.",
                "filterable": false
            },
            "uuid": {
                "type": "string",
                "label": "Uuid",
                "filterable": true
            },
            "created": {
                "type": "datetime",
                "label": "Created",
                "help_text": "Timestamp when this instance was created.",
                "filterable": true
            },
            "modified": {
                "type": "datetime",
                "label": "Modified",
                "help_text": "Timestamp when this instance was last modified.",
                "filterable": true
            },
            "last_seen": {
                "type": "datetime",
                "label": "Last seen",
                "help_text": "Last time instance ran its heartbeat task for main cluster nodes. Last known connection to receptor mesh for execution nodes.",
                "filterable": true
            },
            "health_check_started": {
                "type": "datetime",
                "label": "Health check started",
                "help_text": "The last time a health check was initiated on this instance.",
                "filterable": true
            },
            "health_check_pending": {
                "type": "field",
                "label": "Health check pending",
                "filterable": false
            },
            "last_health_check": {
                "type": "datetime",
                "label": "Last health check",
                "help_text": "Last time a health check was ran on this instance to refresh cpu, memory, and capacity.",
                "filterable": true
            },
            "errors": {
                "type": "string",
                "label": "Errors",
                "help_text": "Any error details from the last health check.",
                "filterable": true
            },
            "capacity_adjustment": {
                "type": "decimal",
                "label": "Capacity adjustment",
                "min_value": 0.0,
                "filterable": true
            },
            "version": {
                "type": "string",
                "label": "Version",
                "filterable": true
            },
            "capacity": {
                "type": "integer",
                "label": "Capacity",
                "min_value": 0,
                "filterable": true
            },
            "consumed_capacity": {
                "type": "field",
                "label": "Consumed capacity",
                "filterable": false
            },
            "percent_capacity_remaining": {
                "type": "field",
                "label": "Percent capacity remaining",
                "filterable": false
            },
            "jobs_running": {
                "type": "integer",
                "label": "Jobs running",
                "help_text": "Count of jobs in the running or waiting state that are targeted for this instance",
                "filterable": false
            },
            "jobs_total": {
                "type": "integer",
                "label": "Jobs total",
                "help_text": "Count of all jobs that target this instance",
                "filterable": false
            },
            "cpu": {
                "type": "decimal",
                "label": "Cpu",
                "filterable": true
            },
            "memory": {
                "type": "integer",
                "label": "Memory",
                "help_text": "Total system memory of this instance in bytes.",
                "filterable": true
            },
            "cpu_capacity": {
                "type": "integer",
                "label": "Cpu capacity",
                "filterable": true
            },
            "mem_capacity": {
                "type": "integer",
                "label": "Mem capacity",
                "filterable": true
            },
            "enabled": {
                "type": "boolean",
                "label": "Enabled",
                "filterable": true
            },
            "managed_by_policy": {
                "type": "boolean",
                "label": "Managed by policy",
                "filterable": true
            },
            "node_type": {
                "type": "choice",
                "label": "Node type",
                "help_text": "Role that this node plays in the mesh.",
                "filterable": true,
                "choices": [
                    ["control", "Control plane node"],
                    ["execution", "Execution plane node"],
                    ["hybrid", "Controller and execution"],
                    ["hop", "Message-passing node, no execution capability"]
                ]
            },
            "node_state": {
                "type": "choice",
                "label": "Node state",
                "help_text": "Indicates the current life cycle stage of this instance.",
                "filterable": true,
                "choices": [
                    ["provisioning", "Provisioning"],
                    ["provision-fail", "Provisioning Failure"],
                    ["installed", "Installed"],
                    ["ready", "Ready"],
                    ["unavailable", "Unavailable"],
                    ["deprovisioning", "De-provisioning"],
                    ["deprovision-fail", "De-provisioning Failure"]
                ]
            },
            "managed": {
                "type": "boolean",
                "label": "Managed",
                "help_text": "If True, this instance is managed by the control plane.",
                "filterable": true
            },
            "ip_address": {
                "type": "string",
                "label": "Ip address",
                "filterable": true
            },
            "peers": {
                "type": "field",
                "label": "Peers",
                "help_text": "Primary keys of receptor addresses to peer to.",
                "filterable": false
            },
            "reverse_peers": {
                "type": "field",
                "label": "Reverse peers",
                "filterable": false
            },
            "listener_port": {
                "type": "integer",
                "label": "Listener port",
                "filterable": false
            },
            "peers_from_control_nodes": {
                "type": "boolean",
                "label": "Peers from control nodes",
                "filterable": false
            },
            "protocol": {
                "type": "field",
                "label": "Protocol",
                "filterable": false
            }
        }
    },
    "types": [
        "instance"
    ]
}