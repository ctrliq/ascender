---
ignore: |
  .github
  .tox
  ascender/main/tests/data/inventory/plugins/**
  # vault files
  ascender/main/tests/data/ansible_utils/playbooks/valid/vault.yml
  ascender/ui/test/e2e/tests/smoke-vars.yml
  ascender/ui/node_modules
  ascender/ui/e2e/node_modules
  tools/docker-compose/_sources
  # django template files
  ascender/api/templates/instance_install_bundle/**

extends: default

rules:
  line-length: disable
  truthy: disable
