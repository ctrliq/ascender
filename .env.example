# Per-machine settings for make and docker compose. Copy to .env (git- and
# docker-ignored) and uncomment what you change. Plain KEY=value lines, no
# quotes. A variable set on the command line or in the environment wins.
#
# Secrets do not go here: the database password and SECRET_KEY live in
# .secrets/ASCENDER_DB_PASSWORD and .secrets/SECRET_KEY (see deploy/README.md).

# production (the default): Secure cookies and HSTS, for a deployment served
# over HTTPS. development: plain HTTP works, and the API root links swagger.
#ASCENDER_MODE=development

# Ports published on the host. The web port answers only this host unless
# ASCENDER_WEB_BIND says otherwise (0.0.0.0: every interface).
#ASCENDER_WEB_BIND=127.0.0.1
#ASCENDER_WEB_PORT=8070
#ASCENDER_DB_LOCAL_PORT=5442

# The database the compose file creates.
#ASCENDER_DB_NAME=ascender
#ASCENDER_DB_USER=ascender

# Beside the old application on the same host, this server needs its own
# cookie names, or each application signs the other's users out. Unset,
# they are the old application's names, for a server that replaces it.
#ASCENDER_SESSION_COOKIE_NAME=ascender_new_sessionid
#ASCENDER_CSRF_COOKIE_NAME=ascender_new_csrftoken
#ASCENDER_LOGGED_IN_COOKIE_NAME=ascender_new_userLoggedIn

# Host directories the task container bind-mounts (owned by uid 1000).
#ASCENDER_PROJECTS_DIR=/var/lib/ascender/projects
#ASCENDER_JOB_PRIVATE_DIR=/var/lib/ascender/job_private

# make run-web / run-task on the host.
#ASCENDER_LISTEN=:8070
#ASCENDER_CONTAINER_RUNTIME=docker
